generator client {
  provider = "prisma-client-js"
  output   = "../generated/client-weekly-v7"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String                    @id @default(uuid())
  username                  String                    @unique
  name                      String
  password                  String
  role                      String
  email                     String?                   @unique
  arabicName                String?
  academicYear              String?
  school                    String?
  signature                 String?
  classTeacherAssignments   ClassTeacher[]
  lessons                   Lesson[]
  quizMarksUpdates          ManagedQuizMark[]         @relation("ManagedQuizMarksUpdater")
  managedMarksUpdates       ManagedStudentMark[]      @relation("ManagedMarksUpdater")
  schedulesCreated          Schedule[]                @relation("ScheduleCreator")
  scheduleItems             ScheduleItem[]
  studentReports            StudentReport[]
  subjectTeacherAssignments SubjectTeacher[]
  weeklyPlannerSubmissions  WeeklyPlannerSubmission[]
  classes                   Class[]                   @relation("TeacherClasses")
  subjects                  Subject[]                 @relation("TeacherSubjects")
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Class {
  id                       String                    @id @default(uuid())
  name                     String
  gradeId                  String?
  grade                    Grade?                    @relation(fields: [gradeId], references: [id])
  classSubjects            ClassSubject[]
  classTeacherAssignments  ClassTeacher[]
  lessons                  Lesson[]
  managedMarkSchemes       ManagedMarkScheme[]
  quizMarks                ManagedQuizMark[]
  managedMarks             ManagedStudentMark[]
  schedules                Schedule[]
  students                 Student[]
  weeklyPlannerSubmissions WeeklyPlannerSubmission[] @relation("ClassToWeeklyPlannerSubmission")
  teachers                 User[]                    @relation("TeacherClasses")

  @@index([gradeId])
}

model Subject {
  id                        String                @id @default(uuid())
  name                      String
  reportOrder               Int                   @default(0)
  adminWeeklyPlanItems      AdminWeeklyPlanItem[]
  classSubjectAssignments   ClassSubject[]
  grades                    GradeSubject[]
  lessons                   Lesson[]
  managedMarkSchemes        ManagedMarkScheme[]
  quizMarks                 ManagedQuizMark[]
  quizMarkSchemes           ManagedQuizScheme?
  managedMarks              ManagedStudentMark[]
  marks                     Mark[]
  scheduleItems             ScheduleItem[]
  studentReports            StudentReport[]
  teacherSubjectAssignments SubjectTeacher[]
  weeklyPlanItems           WeeklyPlanItem[]
  weeklyPlannerItems        WeeklyPlannerItem[]
  teachers                  User[]                @relation("TeacherSubjects")
}

model ClassTeacher {
  id        String @id @default(uuid())
  classId   String
  teacherId String
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  marks     Mark[]

  @@unique([classId, teacherId])
}

model ClassSubject {
  id        String  @id @default(uuid())
  classId   String
  subjectId String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
}

model SubjectTeacher {
  id        String  @id @default(uuid())
  subjectId String
  teacherId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId])
}

model Mark {
  id             String       @id @default(uuid())
  participation  Int?
  behavior       Int?
  workingQuiz    Int?
  project        Int?
  finalExam      Int?
  totalMarks     Int?
  studentId      String
  classTeacherId String
  subjectId      String
  classTeacher   ClassTeacher @relation(fields: [classTeacherId], references: [id], onDelete: Cascade)
  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, classTeacherId])
}

model ManagedStudentMark {
  id              String   @id @default(uuid())
  studentId       String
  classId         String
  subjectId       String
  updatedById     String?
  academicYear    String
  term            String
  participation   Int      @default(0)
  behavior        Int      @default(0)
  workingQuiz     Int      @default(0)
  project         Int      @default(0)
  finalExam       Int      @default(0)
  classActivities Int      @default(0)
  homework        Int      @default(0)
  memorizing      Int      @default(0)
  oralTest        Int      @default(0)
  reading         Int      @default(0)
  totalMarks      Int      @default(0)
  updatedAt       DateTime @updatedAt
  extraMarks      String   @default("{}")
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  updatedBy       User?    @relation("ManagedMarksUpdater", fields: [updatedById], references: [id])

  @@unique([studentId, classId, subjectId, academicYear, term], map: "ManagedStudentMark_studentId_classId_subjectId_academicYear_ter")
  @@index([classId, subjectId, academicYear, term])
}

model ManagedMarkScheme {
  id        String   @id @default(uuid())
  subjectId String
  columns   String
  updatedAt DateTime @updatedAt
  scopeKey  String   @unique
  gradeId   String?
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id], onDelete: Cascade)
  grade     Grade?   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
  @@index([gradeId])
  @@index([classId])
}

model ManagedQuizScheme {
  id        String   @id @default(uuid())
  subjectId String   @unique
  firstMax  Int      @default(10)
  secondMax Int      @default(10)
  updatedAt DateTime @updatedAt
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
}

model ManagedQuizMark {
  id           String   @id @default(uuid())
  studentId    String
  classId      String
  subjectId    String
  updatedById  String?
  academicYear String
  term         String
  firstQuiz    Int      @default(0)
  secondQuiz   Int      @default(0)
  updatedAt    DateTime @updatedAt
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  updatedBy    User?    @relation("ManagedQuizMarksUpdater", fields: [updatedById], references: [id])

  @@unique([studentId, classId, subjectId, academicYear, term], map: "ManagedQuizMark_studentId_classId_subjectId_academicYear_term_k")
  @@index([classId, subjectId, academicYear, term])
}

model Student {
  id               String               @id @default(uuid())
  name             String
  classId          String
  createdAt        DateTime             @default(now())
  managedQuizMarks ManagedQuizMark[]
  managedMarks     ManagedStudentMark[]
  marks            Mark[]
  class            Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  reports          StudentReport[]

  @@index([classId, name])
}

model StudentReport {
  id                String   @id @default(uuid())
  studentId         String
  teacherId         String
  subjectId         String
  academicYear      String
  semester          String
  status            String   @default("Not Started")
  recommendations   String[] @default([])
  comment           String   @default("")
  participation     Int?
  behavior          Int?
  quizScore         Int?
  projectScore      Int?
  finalExam         Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  ixlPracticeStatus String?
  reportType        String   @default("First Report")
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject           Subject  @relation(fields: [subjectId], references: [id])
  teacher           User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([studentId, teacherId, subjectId, academicYear, semester, reportType], map: "StudentReport_studentId_teacherId_subjectId_academicYear_semest")
  @@index([teacherId, academicYear, semester])
}

model Lesson {
  id        String   @id @default(uuid())
  classId   String
  subjectId String
  teacherId String
  date      DateTime
  unit      String
  pages     String
  lesson    String
  objective String
  homework  String?
  createdAt DateTime @default(now())
  comments  String?
  class     Class    @relation(fields: [classId], references: [id])
  subject   Subject  @relation(fields: [subjectId], references: [id])
  teacher   User     @relation(fields: [teacherId], references: [id])

  @@index([teacherId, date])
  @@index([classId, date])
}

model Schedule {
  id        String         @id @default(uuid())
  classId   String
  name      String?
  isActive  Boolean        @default(true)
  createdBy String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  creator   User           @relation("ScheduleCreator", fields: [createdBy], references: [id])
  items     ScheduleItem[]

  @@index([classId, isActive])
}

model ScheduleItem {
  id         String   @id @default(uuid())
  scheduleId String
  dayIndex   Int
  session    Int      @default(0)
  start      String   @default("")
  end        String   @default("")
  subjectId  String
  teacherId  String?
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  subject    Subject  @relation(fields: [subjectId], references: [id])
  teacher    User?    @relation(fields: [teacherId], references: [id])

  @@index([scheduleId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([dayIndex, session])
}

model Grade {
  id                 String              @id @default(uuid())
  name               String              @unique
  adminWeeklyPlans   AdminWeeklyPlan[]
  classes            Class[]
  subjects           GradeSubject[]
  managedMarkSchemes ManagedMarkScheme[]
  plans              WeeklyPlan[]
  adminNotes         AdminPlannerNote[]  @relation("AdminPlannerNoteGrades")
}

model GradeSubject {
  gradeId   String
  subjectId String
  position  Int     @default(0)
  grade     Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([gradeId, subjectId])
}

model WeeklyPlan {
  id        String           @id @default(uuid())
  gradeId   String?
  week      String
  fromDate  DateTime
  toDate    DateTime
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  note      String?
  dictation String?
  grade     Grade?           @relation(fields: [gradeId], references: [id])
  items     WeeklyPlanItem[]
}

model WeeklyPlanItem {
  id           String     @id @default(uuid())
  weeklyPlanId String
  subjectId    String
  unit         String
  lessons      String
  pages        String
  homework     String?
  classwork    String?
  dictation    String?
  subject      Subject    @relation(fields: [subjectId], references: [id])
  weeklyPlan   WeeklyPlan @relation(fields: [weeklyPlanId], references: [id], onDelete: Cascade)
}

model WeeklyPlannerSubmission {
  id        String              @id @default(uuid())
  teacherId String
  week      String
  semester  String?
  fromDate  DateTime
  toDate    DateTime
  dictation String?
  notes     String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  items     WeeklyPlannerItem[]
  teacher   User                @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classes   Class[]             @relation("ClassToWeeklyPlannerSubmission")

  @@index([week, fromDate, toDate])
  @@index([teacherId])
}

model WeeklyPlannerItem {
  id           String                  @id @default(uuid())
  submissionId String
  subjectId    String
  classwork    String                  @default("")
  homework     String                  @default("")
  subject      Subject                 @relation(fields: [subjectId], references: [id])
  submission   WeeklyPlannerSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model AdminPlannerNote {
  id        String   @id @default(uuid())
  content   String
  scope     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  week      String   @default("")
  grades    Grade[]  @relation("AdminPlannerNoteGrades")

  @@index([scope, week, updatedAt])
}

model AdminWeeklyPlan {
  id             String                @id @default(uuid())
  gradeId        String
  week           String
  semester       String?
  fromDate       DateTime
  toDate         DateTime
  dictation      String?
  notes          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  dictationStyle String?
  notesStyle     String?
  grade          Grade                 @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  items          AdminWeeklyPlanItem[]

  @@unique([gradeId, week])
  @@index([week, fromDate, toDate])
}

model AdminWeeklyPlanItem {
  id                String          @id @default(uuid())
  adminWeeklyPlanId String
  subjectId         String
  classwork         String          @default("")
  homework          String          @default("")
  classworkStyle    String?
  homeworkStyle     String?
  plan              AdminWeeklyPlan @relation(fields: [adminWeeklyPlanId], references: [id], onDelete: Cascade)
  subject           Subject         @relation(fields: [subjectId], references: [id])

  @@unique([adminWeeklyPlanId, subjectId])
}

enum Role {
  TEACHER
  ADMIN
  COORDINATOR
}
